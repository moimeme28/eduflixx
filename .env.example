# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

SUPABASE_PROJECT_ID="your-supabase-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project.lovable.cloud"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project.lovable.cloud"

# TMDB API (movie/TV data for browsing, search, and AI recommendations)
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY="your-tmdb-api-key"

# Google Gemini API (powers AI chat + study guides)
# Provided via the Lovable AI gateway
LOVABLE_API_KEY="your-lovable-api-key"

# Mongo API gateway (local gateway that talks to MongoDB Atlas)
MONGO_API_URL="http://localhost:8787"
MONGO_API_KEY="your-shared-secret"
